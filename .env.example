# ── DATABASE ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/primaria_db?schema=public"
REDIS_URL="redis://default:PASSWORD@HOST:PORT"

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET="CHANGE_ME_min_32_chars_random_string"
JWT_REFRESH_SECRET="CHANGE_ME_different_min_32_chars_random_string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ── QR DELIVERY ────────────────────────────────────────────────────────────────
QR_HMAC_SECRET="CHANGE_ME_min_32_chars_for_qr_tokens"

# ── STRIPE ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── RESEND (EMAIL) ─────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@primar-ia.com"

# ── CLOUDFLARE R2 ──────────────────────────────────────────────────────────────
R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="primaria-uploads"
R2_PUBLIC_URL="https://uploads.primar-ia.com"

# ── APP ────────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3001"
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
CORS_ORIGIN="http://localhost:3000"
