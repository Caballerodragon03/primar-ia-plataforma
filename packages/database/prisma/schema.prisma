generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  VENDEDOR
  COMPRADOR
  ADMIN
}

enum UserEstado {
  EMAIL_NO_VERIFICADO
  EMAIL_VERIFICADO
  PENDIENTE_VERIFICACION
  VERIFICADO_ACTIVO
  RECHAZADO
  PENDIENTE_ACLARACION
  SUSPENDIDO
}

enum CertificadoEstado {
  PENDIENTE
  VERIFICADO
  RECHAZADO
  CADUCADO
}

enum LoteTipo {
  VENTA_DIRECTA
  SUBASTA
}

enum LoteEstado {
  BORRADOR
  ACTIVO
  PARCIALMENTE_VENDIDO
  VENDIDO
  EXPIRADO
  CANCELADO
}

enum PedidoEstado {
  BORRADOR
  ACTIVO
  PARCIALMENTE_CUBIERTO
  TOTALMENTE_CUBIERTO
  CERRADO
  CANCELADO
}

enum MatchEstado {
  PROPUESTO
  ENVIADO_VENDEDOR
  ACEPTADO_VENDEDOR
  RECHAZADO_VENDEDOR
  PENDIENTE_PAGO
  CONFIRMADO
  CANCELADO
}

enum Incoterm {
  EXW
  FCA
  FOB
  CIF
  DAP
  DDP
  FAS
  CFR
  CPT
  CIP
  DAT
  DPU
}

// Quién se encarga de la logística desde el punto de vista del listador.
// YO_ENVIO       = el vendedor envía / el comprador no tiene que recoger
// OTRO_RECOGE    = el vendedor no envía / el comprador debe recoger
// INDIFERENTE    = sin preferencia (abierto a ambas)
enum LogisticaPreferencia {
  YO_ENVIO
  OTRO_RECOGE
  INDIFERENTE
}

// Términos de pago acordados o aceptados.
enum TerminoPago {
  INMEDIATO
  DIAS_30
  DIAS_60
}

// Régimen fiscal del vendedor — necesario para emitir facturas correctas.
enum RegimenFiscal {
  GENERAL                  // 21% IVA, 0% retención
  AGRARIO                  // régimen especial agrario: IVA reducido (4% / 10%), IRPF 2%
  RECARGO_EQUIVALENCIA     // minoristas, sin IRPF, IVA + recargo
  EXENTO                   // exento de IVA (operaciones exteriores, etc.)
}

// Estado del contrato dentro del flujo de firma/pago.
enum ContratoEstado {
  BORRADOR                 // generado pero ninguno ha firmado
  PENDIENTE_FIRMA_VENDEDOR // vendedor todavía no ha firmado
  PENDIENTE_PAGO_COMPRADOR // vendedor firmó, comprador debe pagar comisión + firmar
  FIRMADO                  // ambos firmaron, comisión pagada
  CADUCADO                 // vendedor firmó pero comprador no pagó/firmó en 48h hábiles
  CANCELADO                // alguna parte canceló antes de completar
}

// Tipos de evento que dispara una alerta anti-bypass.
enum BypassAlertEstado {
  PENDIENTE
  AVISADO
  BANEADO
  DESCARTADO
}

// Estado de revisión de un patrón de cancelaciones sospechosas.
enum CancelacionEstado {
  PENDIENTE
  INVESTIGADA
  AVISADO
  SUSPENDIDO
}

enum TransaccionEstado {
  PENDIENTE_PAGO
  PAGO_CAPTURADO
  EN_TRANSITO
  ENTREGADO
  EN_DISPUTA
  COMPLETADO
  CANCELADO
  REEMBOLSADO
}

enum MensajeTipo {
  TEXTO
  IMAGEN
  DOCUMENTO
  OFERTA
}

enum NegociacionEstado {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  SUPERADA
}

enum ValoracionEstado {
  PUBLICADA
  PENDIENTE_REVISION
  RECHAZADA
}

enum ValoracionTipo {
  VENDEDOR_A_COMPRADOR
  COMPRADOR_A_VENDEDOR
}

enum DisputaTipo {
  CALIDAD
  CANTIDAD
  EMPAQUETADO
  CALIBRES
  PRODUCTO_DIFERENTE
  RETRASO_ENTREGA
  PAGO_NO_RECIBIDO
  COMPRADOR_NO_RESPONDE
  RECHAZO_INJUSTIFICADO
  LOGISTICA
  DATOS_INCORRECTOS
  CANCELACION_COMPRADOR
  OTRO
}

enum DisputaEstado {
  ABIERTA
  RESPUESTA_VENDEDOR
  EN_REVISION
  RESUELTA
}

enum DisputaResolucion {
  FAVOR_COMPRADOR
  FAVOR_VENDEDOR
  PARCIAL
  ACUERDO_PARTES
}

enum Tendencia {
  UP
  DOWN
  STABLE
}

enum SuscripcionEstado {
  ACTIVA
  CANCELADA
  PAUSADA
  TRIAL
  PENDIENTE
}

enum PlanVendedor {
  COSECHA
  CAMPO
  FINCA
}

enum PlanComprador {
  MERCADO
  LONJA
  CENTRAL
}

enum Idioma {
  ES
  EN
}

enum ScoreStatus {
  NEW_USER
  ACTIVE
  RESTRICTED
}

enum ScoreEventTipo {
  PRIMERA_TRANSACCION
  TRANSACCION_OK
  INCIDENCIA_ABIERTA
  DISPUTA_RESUELTA_CONTRA
  DISPUTA_RESUELTA_FAVOR
  RATING_RECIBIDO
  ADMIN_PENALIZACION
  ADMIN_INCENTIVO
}

// ─── MODELOS ─────────────────────────────────────────────────────────────────

model User {
  id                      String     @id @default(cuid())
  email                   String     @unique
  username                String     @unique
  passwordHash            String     @map("password_hash")
  role                    UserRole
  estado                  UserEstado @default(EMAIL_NO_VERIFICADO)
  nombre                  String
  apellidos               String
  telefono                String?
  fotoPerfil              String?    @map("foto_perfil_url")
  idioma                  Idioma     @default(ES)
  preferenciasNotif       Json?      @map("preferencias_notificaciones")
  preferenciasIncoterm   Json?      @map("preferencias_incoterm")
  creditosCreacion        Int        @default(3) @map("creditos_creacion")
  proximaRegeneracionCredito DateTime? @map("proxima_regeneracion_credito")
  loginAttempts           Int        @default(0) @map("login_attempts")
  lockedUntil             DateTime?  @map("locked_until")
  scoreFiabilidad         Decimal?   @map("score_fiabilidad") @db.Decimal(5, 2)
  scoreStatus             ScoreStatus @default(NEW_USER) @map("score_status")
  transaccionesOk         Int        @default(0) @map("transacciones_ok")
  transaccionesIncid      Int        @default(0) @map("transacciones_incid")
  ratingMedio             Decimal?   @map("rating_medio") @db.Decimal(3, 2)
  numValoraciones         Int        @default(0) @map("num_valoraciones")
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  empresa                 Empresa?
  certificados            Certificado[]
  lotes                   Lote[]
  pedidos                 Pedido[]
  transaccionesVendedor   Transaccion[]  @relation("TransaccionVendedor")
  transaccionesComprador  Transaccion[]  @relation("TransaccionComprador")
  mensajes                Mensaje[]
  valoracionesEmitidas    Valoracion[]   @relation("ValoracionAutor")
  valoracionesRecibidas   Valoracion[]   @relation("ValoracionDestinatario")
  disputasAbiertas        Disputa[]      @relation("DisputaAbiertaPor")
  disputasAdmin           Disputa[]      @relation("DisputaAdmin")
  negociacionesIniciadas  Negociacion[]  @relation("NegociacionIniciador")
  refreshTokens           RefreshToken[]
  emailTokens             EmailToken[]
  suscripcion             Suscripcion?
  auditoria               Auditoria[]
  certificadosVerificados Certificado[]  @relation("CertificadoVerificador")
  scoreEventsUser         ScoreEvent[]   @relation("ScoreEventUser")
  scoreEventsAdmin        ScoreEvent[]   @relation("ScoreEventAdmin")
  disputaMensajes         DisputaMensaje[]
  historialCosechas       HistorialCosecha[]

  @@index([email])
  @@index([username])
  @@index([role, estado])
  @@index([proximaRegeneracionCredito])
  @@map("users")
}

model Empresa {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  razonSocial           String   @map("razon_social")
  cifNif                String   @unique @map("cif_nif")
  formaJuridica         String?  @map("forma_juridica")
  direccionFiscal       String   @map("direccion_fiscal")
  ciudad                String?
  codigoPostal          String?  @map("codigo_postal")
  pais                  String   @default("ES")
  personaContactoLegal  String   @map("persona_contacto_legal")
  cargoContactoLegal    String   @map("cargo_contacto_legal")
  stripeAccountId       String?  @map("stripe_account_id")
  stripeOnboardingDone  Boolean  @default(false) @map("stripe_onboarding_done")
  stripeCustomerId      String?  @map("stripe_customer_id")
  descripcion           String?
  fotosUrls             Json?    @map("fotos_urls")
  // Datos bancarios para que el comprador transfiera al vendedor.
  // IBAN español formato 24 dígitos; otras geografías permitidas.
  iban                  String?  @map("iban")
  swiftBic              String?  @map("swift_bic")
  // Régimen fiscal — se usa para generar facturas correctas con IVA/IRPF.
  regimenFiscal         RegimenFiscal @default(GENERAL) @map("regimen_fiscal")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cifNif])
  @@index([stripeAccountId])
  @@map("empresas")
}

model Certificado {
  id                  String            @id @default(cuid())
  userId              String            @map("user_id")
  numeroCertificado   String            @map("numero_certificado")
  fechaEmision        DateTime          @map("fecha_emision")
  fechaCaducidad      DateTime          @map("fecha_caducidad")
  archivoUrl          String            @map("archivo_url")
  archivoHashSha256   String            @map("archivo_hash_sha256")
  estado              CertificadoEstado @default(PENDIENTE)
  adminVerificadorId  String?           @map("admin_verificador_id")
  fechaVerificacion   DateTime?         @map("fecha_verificacion")
  notasVerificacion   String?           @map("notas_verificacion")
  alerta60Enviada     Boolean           @default(false) @map("alerta_60_enviada")
  alerta30Enviada     Boolean           @default(false) @map("alerta_30_enviada")
  alerta15Enviada     Boolean           @default(false) @map("alerta_15_enviada")
  alerta7Enviada      Boolean           @default(false) @map("alerta_7_enviada")
  createdAt           DateTime          @default(now()) @map("created_at")

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminVerificador    User?             @relation("CertificadoVerificador", fields: [adminVerificadorId], references: [id])

  @@index([userId, estado])
  @@index([fechaCaducidad, estado])
  @@map("certificados")
}

model Producto {
  id          String     @id @default(cuid())
  nombre      String     @unique
  categoria   String
  imagen      String?
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at")

  variedades        Variedad[]
  lotes             Lote[]
  pedidos           Pedido[]
  datosMercado      DatosMercado[]
  historialCosechas HistorialCosecha[]

  @@map("productos")
}

model Variedad {
  id         String   @id @default(cuid())
  productoId String   @map("producto_id")
  nombre     String
  createdAt  DateTime @default(now()) @map("created_at")

  producto          Producto @relation(fields: [productoId], references: [id])
  lotes             Lote[]
  pedidos           Pedido[]
  datosMercado      DatosMercado[]
  historialCosechas HistorialCosecha[]

  @@unique([productoId, nombre])
  @@map("variedades")
}

model Lote {
  id                     String     @id @default(cuid())
  vendedorId             String     @map("vendedor_id")
  productoId             String     @map("producto_id")
  variedadId             String?    @map("variedad_id")
  tipo                   LoteTipo
  calibres               Json
  datosHistoricos        Json?      @map("datos_historicos")
  direccionRecogida      String     @map("direccion_recogida")
  coordenadasLat         Float?     @map("coordenadas_lat")
  coordenadasLng         Float?     @map("coordenadas_lng")
  fechaDisponibilidad    DateTime   @map("fecha_disponibilidad")
  fechaFinDisponibilidad DateTime?  @map("fecha_fin_disponibilidad")
  certificaciones        Json?
  fotosUrls              Json?      @map("fotos_urls")
  comentariosAdicionales String?    @map("comentarios_adicionales")
  estado                 LoteEstado @default(BORRADOR)
  // Quién se encarga del envío/recogida desde el punto de vista del vendedor.
  logistica              LogisticaPreferencia @default(INDIFERENTE)
  // Incoterms que el vendedor acepta (filtra los matches).
  // String[] de Incoterm. Default a [] (sin restricciones — equivalente a "todos").
  incotermsAceptados     Json       @default("[]") @map("incoterms_aceptados")
  // Términos de pago que el vendedor acepta. Multi-select.
  // String[] de TerminoPago. Default a ["INMEDIATO"].
  terminosPagoAceptados  Json       @default("[\"INMEDIATO\"]") @map("terminos_pago_aceptados")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  vendedor               User       @relation(fields: [vendedorId], references: [id])
  producto               Producto   @relation(fields: [productoId], references: [id])
  variedad               Variedad?  @relation(fields: [variedadId], references: [id])
  matches                Match[]

  @@index([vendedorId, estado])
  @@index([productoId, estado])
  @@index([fechaDisponibilidad])
  @@map("lotes")
}

model Pedido {
  id                     String       @id @default(cuid())
  compradorId            String       @map("comprador_id")
  productoId             String       @map("producto_id")
  variedadId             String?      @map("variedad_id")
  calibresSolicitados    Json         @map("calibres_solicitados")
  incoterm               Incoterm
  destinoFinal           String?      @map("destino_final")
  frecuencia             String?
  transporte             String?
  costoLogisticaEstimado Decimal?     @map("costo_logistica_estimado") @db.Decimal(10, 2)
  fechaEntregaDeseada    DateTime     @map("fecha_entrega_deseada")
  notasAdicionales       String?      @map("notas_adicionales")
  destinoLat             Float?       @map("destino_lat")
  destinoLng             Float?       @map("destino_lng")
  estado                 PedidoEstado @default(BORRADOR)
  stripePaymentIntentId  String?      @unique @map("stripe_payment_intent_id")
  contratoPdfUrl         String?      @map("contrato_pdf_url")
  // Quién recoge/envía desde el punto de vista del comprador.
  logistica              LogisticaPreferencia @default(INDIFERENTE)
  // Incoterms que el comprador acepta (multi). Si está vacío, se asume el campo
  // legacy `incoterm` como única opción aceptada.
  incotermsAceptados     Json         @default("[]") @map("incoterms_aceptados")
  // Términos de pago que el comprador acepta. Multi-select.
  terminosPagoAceptados  Json         @default("[\"INMEDIATO\"]") @map("terminos_pago_aceptados")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  comprador              User         @relation(fields: [compradorId], references: [id])
  producto               Producto     @relation(fields: [productoId], references: [id])
  variedad               Variedad?    @relation(fields: [variedadId], references: [id])
  matches                Match[]

  @@index([compradorId, estado])
  @@index([productoId, estado])
  @@map("pedidos")
}

model Match {
  id            String      @id @default(cuid())
  loteId        String      @map("lote_id")
  pedidoId      String      @map("pedido_id")
  cantidadKg    Decimal     @map("cantidad_kg") @db.Decimal(10, 2)
  precioKg      Decimal     @map("precio_kg") @db.Decimal(10, 4)
  calibresJson  Json        @map("calibres_json")
  estado        MatchEstado @default(PROPUESTO)
  scoreMatching Float?      @map("score_matching")
  scoreDetalle  Json?       @map("score_detalle")
  visibleDesde  DateTime    @default(now()) @map("visible_desde")
  // Condiciones finales acordadas en chat antes de firmar. Snapshot que se
  // refleja en el contrato y en la factura. Si null, se hereda del Lote/Pedido.
  incotermFinal       Incoterm?            @map("incoterm_final")
  logisticaFinal      LogisticaPreferencia? @map("logistica_final")
  terminoPagoFinal    TerminoPago?         @map("termino_pago_final")
  precioKgFinal       Decimal?             @db.Decimal(10, 4) @map("precio_kg_final")
  // Flujo de contrato: borrador (con watermark) y estado de firma.
  contratoEstado          ContratoEstado @default(BORRADOR) @map("contrato_estado")
  contratoBorradorUrl     String?        @map("contrato_borrador_url")
  // Snapshot de la comisión calculada al generar el contrato borrador.
  comisionEstimada        Decimal?       @db.Decimal(10, 2) @map("comision_estimada")
  comisionPorcentaje      Decimal?       @db.Decimal(6, 5)  @map("comision_porcentaje")
  // Si el vendedor firma, el comprador tiene 48h hábiles para pagar+firmar.
  firmaVendedorDeadline   DateTime?      @map("firma_vendedor_deadline")
  // Tracking de cancelaciones — útil para anti-bypass admin tab.
  canceladoPor            String?        @map("cancelado_por") // userId of canceller
  canceladoEn             DateTime?      @map("cancelado_en")
  motivoCancelacion       String?        @map("motivo_cancelacion") @db.VarChar(500)
  createdAt     DateTime    @default(now()) @map("created_at")

  lote          Lote        @relation(fields: [loteId], references: [id])
  pedido        Pedido      @relation(fields: [pedidoId], references: [id])
  transaccion   Transaccion?

  @@unique([loteId, pedidoId])
  @@index([loteId, estado])
  @@index([pedidoId, estado])
  // Used by the market analytics queries (estado='CONFIRMADO' + date range)
  @@index([estado, createdAt])
  // Used by the cron that auto-caduca contratos a las 48h hábiles
  @@index([contratoEstado, firmaVendedorDeadline])
  @@map("matches")
}

model Transaccion {
  id                    String            @id @default(cuid())
  matchId               String            @unique @map("match_id")
  vendedorId            String            @map("vendedor_id")
  compradorId           String            @map("comprador_id")
  cantidadKg            Decimal           @map("cantidad_kg") @db.Decimal(10, 2)
  precioTotal           Decimal           @map("precio_total") @db.Decimal(12, 2)
  comisionPlataforma    Decimal           @map("comision_plataforma") @db.Decimal(10, 2)
  comisionPorcentaje    Decimal           @map("comision_porcentaje") @db.Decimal(5, 4)
  metodoPago            String?           @map("metodo_pago")
  stripePaymentIntentId String?           @unique @map("stripe_payment_intent_id")
  stripeTransferId      String?           @map("stripe_transfer_id")
  estado                TransaccionEstado @default(PENDIENTE_PAGO)
  qrToken               String?           @unique @map("qr_token")
  qrUsado               Boolean           @default(false) @map("qr_usado")
  qrFechaUso            DateTime?         @map("qr_fecha_uso")
  contratoPdfUrl        String?           @map("contrato_pdf_url")
  firmaComprador        String?           @map("firma_comprador")
  firmaCompradorFecha   DateTime?         @map("firma_comprador_fecha")
  firmaVendedor         String?           @map("firma_vendedor")
  firmaVendedorFecha    DateTime?         @map("firma_vendedor_fecha")
  fotosLoteUrls         Json?             @map("fotos_lote_urls")
  facturaPlataformaUrl  String?           @map("factura_plataforma_url")
  facturaVendedorUrl    String?           @map("factura_vendedor_url")
  resguardoPagoUrl      String?           @map("resguardo_pago_url")
  // Stripe charge cobrado al comprador por la comisión de la plataforma.
  comisionStripeChargeId String?          @map("comision_stripe_charge_id")
  // Stripe Checkout Session activa para el pago de comisión. Se persiste
  // ANTES de redirigir al comprador para poder reusar la misma sesión si
  // el webhook tarda y el comprador vuelve a la página: previene cobro doble.
  // Se limpia al pagar (webhook) o al expirar (24h Stripe TTL).
  comisionStripeSessionId String?         @map("comision_stripe_session_id")
  comisionPagadaEn      DateTime?         @map("comision_pagada_en")
  // Vencimiento que el comprador tiene para pagar al vendedor por la operación
  // (no la comisión a primar-IA). Se calcula a partir del termino_pago_final.
  vencimientoPagoVendedor DateTime?       @map("vencimiento_pago_vendedor")
  // Eventos clave para disparar valoraciones recíprocas.
  enviadoEn             DateTime?         @map("enviado_en")
  recibidoEn            DateTime?         @map("recibido_en")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  match                 Match             @relation(fields: [matchId], references: [id])
  vendedor              User              @relation("TransaccionVendedor", fields: [vendedorId], references: [id])
  comprador             User              @relation("TransaccionComprador", fields: [compradorId], references: [id])
  mensajes              Mensaje[]
  valoraciones          Valoracion[]
  disputas              Disputa[]
  negociaciones         Negociacion[]

  @@index([vendedorId, estado])
  @@index([compradorId, estado])
  @@index([estado])
  @@map("transacciones")
}

model Mensaje {
  id              String      @id @default(cuid())
  transaccionId   String      @map("transaccion_id")
  remitenteId     String      @map("remitente_id")
  contenido       String      @db.VarChar(2000)
  tipo            MensajeTipo @default(TEXTO)
  archivoUrl      String?     @map("archivo_url")
  leido           Boolean     @default(false)
  intentoBypass   Boolean     @default(false) @map("intento_bypass")
  negociacionId   String?     @unique @map("negociacion_id")
  createdAt       DateTime    @default(now()) @map("created_at")

  transaccion     Transaccion  @relation(fields: [transaccionId], references: [id])
  remitente       User         @relation(fields: [remitenteId], references: [id])
  negociacion     Negociacion? @relation(fields: [negociacionId], references: [id])

  @@index([transaccionId, createdAt])
  @@index([remitenteId, leido])
  @@map("mensajes")
}

model Negociacion {
  id              String             @id @default(cuid())
  transaccionId   String             @map("transaccion_id")
  iniciadorId     String             @map("iniciador_id")
  precioKg        Decimal?           @db.Decimal(10, 4) @map("precio_kg")
  incoterm        Incoterm?
  estado          NegociacionEstado  @default(PENDIENTE)
  parentId        String?            @map("parent_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  transaccion     Transaccion        @relation(fields: [transaccionId], references: [id])
  iniciador       User               @relation("NegociacionIniciador", fields: [iniciadorId], references: [id])
  parent          Negociacion?       @relation("Contraoferta", fields: [parentId], references: [id])
  contraofertas   Negociacion[]      @relation("Contraoferta")
  mensaje         Mensaje?

  @@index([transaccionId])
  @@map("negociaciones")
}

model Valoracion {
  id             String           @id @default(cuid())
  transaccionId  String           @map("transaccion_id")
  autorId        String           @map("autor_id")
  destinatarioId String           @map("destinatario_id")
  tipo           ValoracionTipo
  calidad        Int?             @db.SmallInt
  puntualidad    Int              @db.SmallInt
  comunicacion   Int              @db.SmallInt
  empaquetado    Int?             @db.SmallInt
  profesionalidad Int?            @db.SmallInt
  comentario     String?          @db.VarChar(500)
  estado         ValoracionEstado @default(PUBLICADA)
  createdAt      DateTime         @default(now()) @map("created_at")

  transaccion    Transaccion      @relation(fields: [transaccionId], references: [id])
  autor          User             @relation("ValoracionAutor", fields: [autorId], references: [id])
  destinatario   User             @relation("ValoracionDestinatario", fields: [destinatarioId], references: [id])

  @@unique([transaccionId, autorId])
  @@index([destinatarioId, estado])
  @@map("valoraciones")
}

model Disputa {
  id                     String             @id @default(cuid())
  transaccionId          String             @map("transaccion_id")
  abiertaPorId           String             @map("abierta_por_id")
  tipoProblema           DisputaTipo        @map("tipo_problema")
  descripcion            String
  evidenciasUrls         Json               @map("evidencias_urls")
  respuestaVendedor      String?            @map("respuesta_vendedor")
  evidenciasVendedorUrls Json?              @map("evidencias_vendedor_urls")
  resolucion             DisputaResolucion?
  porcentajeComprador    Decimal?           @map("porcentaje_comprador") @db.Decimal(5, 2)
  porcentajeVendedor     Decimal?           @map("porcentaje_vendedor") @db.Decimal(5, 2)
  penalizacionComprador  Decimal?           @map("penalizacion_comprador") @db.Decimal(5, 2)
  penalizacionVendedor   Decimal?           @map("penalizacion_vendedor") @db.Decimal(5, 2)
  incentivoComprador     Decimal?           @map("incentivo_comprador") @db.Decimal(5, 2)
  incentivoVendedor      Decimal?           @map("incentivo_vendedor") @db.Decimal(5, 2)
  suscripcionGratisUserId String?           @map("suscripcion_gratis_user_id")
  adminId                String?            @map("admin_id")
  notasAdmin             String?            @map("notas_admin")
  estado                 DisputaEstado      @default(ABIERTA)
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  transaccion            Transaccion        @relation(fields: [transaccionId], references: [id])
  abiertaPor             User               @relation("DisputaAbiertaPor", fields: [abiertaPorId], references: [id])
  admin                  User?              @relation("DisputaAdmin", fields: [adminId], references: [id])
  mensajes               DisputaMensaje[]

  @@index([transaccionId])
  @@index([estado])
  @@map("disputas")
}

model DatosMercado {
  id                   String    @id @default(cuid())
  productoId           String    @map("producto_id")
  variedadId           String?   @map("variedad_id")
  precioMedioMes       Decimal   @map("precio_medio_mes") @db.Decimal(10, 4)
  volumenTotalMes      Decimal   @map("volumen_total_mes") @db.Decimal(12, 2)
  tendencia            Tendencia
  variedadMasVendida   String?   @map("variedad_mas_vendida")
  fechaCalculo         DateTime  @map("fecha_calculo") @db.Date
  numTransaccionesBase Int       @map("num_transacciones_base")

  producto             Producto  @relation(fields: [productoId], references: [id])
  variedad             Variedad? @relation(fields: [variedadId], references: [id])

  @@unique([productoId, variedadId, fechaCalculo])
  @@index([fechaCalculo])
  @@map("datos_mercado")
}

model Suscripcion {
  id                   String            @id @default(cuid())
  userId               String            @unique @map("user_id")
  planVendedor         PlanVendedor?     @map("plan_vendedor")
  planComprador        PlanComprador?    @map("plan_comprador")
  stripeSubscriptionId String?           @unique @map("stripe_subscription_id")
  stripeCustomerId     String?           @map("stripe_customer_id")
  stripePriceId        String?           @map("stripe_price_id")
  estado               SuscripcionEstado @default(ACTIVA)
  fechaInicio          DateTime          @map("fecha_inicio")
  fechaFin             DateTime?         @map("fecha_fin")
  trialEndsAt          DateTime?         @map("trial_ends_at")
  cancelledAt          DateTime?         @map("cancelled_at")
  comoCompensacion     Boolean           @default(false) @map("como_compensacion")
  compensacionMeses    Int?              @map("compensacion_meses")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Used by the Stripe customer portal lookup
  @@index([stripeCustomerId])
  @@map("suscripciones")
}

model HistorialCosecha {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  productoId        String   @map("producto_id")
  variedadId        String?  @map("variedad_id")
  temporada         String
  calibres          Json
  archivoExcelUrl   String?  @map("archivo_excel_url")
  estimacionProxima Json?    @map("estimacion_proxima")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  producto          Producto @relation(fields: [productoId], references: [id])
  variedad          Variedad? @relation(fields: [variedadId], references: [id])

  @@index([userId, productoId])
  @@map("historial_cosechas")
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  token      String   @unique
  deviceInfo String?  @map("device_info")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  tipo      String
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_tokens")
}

model Auditoria {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  accion    String
  entidad   String
  entidadId String?  @map("entidad_id")
  datos     Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entidad, entidadId])
  @@index([createdAt])
  @@map("auditoria")
}

model ScoreEvent {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  tipo           ScoreEventTipo
  delta          Decimal        @db.Decimal(6, 2)
  scoreAntes     Decimal?       @map("score_antes") @db.Decimal(5, 2)
  scoreDespues   Decimal        @map("score_despues") @db.Decimal(5, 2)
  motivo         String?
  referenciaTipo String?        @map("referencia_tipo")
  referenciaId   String?        @map("referencia_id")
  adminId        String?        @map("admin_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  user           User           @relation("ScoreEventUser", fields: [userId], references: [id])
  admin          User?          @relation("ScoreEventAdmin", fields: [adminId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("score_events")
}

model DisputaMensaje {
  id         String   @id @default(cuid())
  disputaId  String   @map("disputa_id")
  autorId    String   @map("autor_id")
  contenido  String   @db.VarChar(2000)
  archivoUrl String?  @map("archivo_url")
  createdAt  DateTime @default(now()) @map("created_at")

  disputa    Disputa  @relation(fields: [disputaId], references: [id])
  autor      User     @relation(fields: [autorId], references: [id])

  @@index([disputaId, createdAt])
  @@map("disputa_mensajes")
}

model BannedEntry {
  id        String   @id @default(cuid())
  email     String?
  cifNif    String?  @map("cif_nif")
  reason    String?
  bannedBy  String   @map("banned_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email])
  @@unique([cifNif])
  @@map("banned_entries")
}

enum BugReportEstado {
  NUEVO
  EN_PROGRESO
  RESUELTO
  DESCARTADO
}

model BugReport {
  id            String          @id @default(cuid())
  userId        String?         @map("user_id") // nullable: allow logged-out reports if added later
  url           String?         @db.Text
  descripcion   String          @db.Text
  capturaUrl    String?         @map("captura_url") @db.Text
  userAgent     String?         @map("user_agent")
  estado        BugReportEstado @default(NUEVO)
  adminNotas    String?         @map("admin_notas") @db.Text
  resolvedAt    DateTime?       @map("resolved_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([estado])
  @@index([createdAt])
  @@map("bug_reports")
}

// Alertas generadas por la IA (Gemini) al revisar mensajes del chat en
// busca de patrones de bypass (compartir teléfono/email/redes, mover la
// conversación fuera de la plataforma, etc.). Procesadas en cron diario.
model BypassAlert {
  id                String            @id @default(cuid())
  mensajeId         String            @unique @map("mensaje_id")
  remitenteId       String            @map("remitente_id")
  receptorId        String?           @map("receptor_id")
  // Score 0-100 producido por la IA (mayor = más sospechoso).
  score             Int
  // Patrones detectados: phone | email | messaging | location | offer_off_platform | other
  patrones          Json
  // Extracto del mensaje detectado para la admin UI.
  extracto          String?           @db.VarChar(500)
  estado            BypassAlertEstado @default(PENDIENTE)
  accionTomada      String?           @map("accion_tomada")
  adminId           String?           @map("admin_id")
  resolvedAt        DateTime?         @map("resolved_at")
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([estado, createdAt])
  @@index([remitenteId])
  @@map("bypass_alerts")
}

// Tracking de parejas vendedor-comprador que cancelan matches repetidamente,
// patrón sospechoso de bypass de plataforma.
model CancelacionSospechosa {
  id                  String            @id @default(cuid())
  vendedorId          String            @map("vendedor_id")
  compradorId         String            @map("comprador_id")
  totalCancelaciones  Int               @default(1) @map("total_cancelaciones")
  ultimaCancelacionAt DateTime          @map("ultima_cancelacion_at")
  estado              CancelacionEstado @default(PENDIENTE)
  accionTomada        String?           @map("accion_tomada")
  adminId             String?           @map("admin_id")
  notas               String?           @db.Text
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@unique([vendedorId, compradorId])
  @@index([estado, ultimaCancelacionAt])
  @@map("cancelaciones_sospechosas")
}

// Weekly auto-generated market report from mapa.gob.es boletín semanal
model MarketReport {
  id          String   @id @default(cuid())
  semana      String   @unique // e.g. "2026-W18"
  periodo     String   // e.g. "27 abril - 3 mayo"
  resumen     String   @db.Text // Gemini-generated summary
  highlights  Json?    // { alza: string[], baja: string[], sentimiento: string }
  fuenteUrl   String   @map("fuente_url")
  pdfText     String?  @db.Text @map("pdf_text") // raw extracted text for re-summarization
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("market_reports")
}
